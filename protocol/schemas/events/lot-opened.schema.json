{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockholm.banghak/protocol/events/lot-opened.schema.json",
  "title": "LotOpened",
  "description": "매수 체결로 lot 이 열림. 이벤트 로그 payload(type = LotOpened, payload_version 1). 동기화 범위 LOCAL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lotId", "symbol", "quantity", "unitCost", "origin", "openedAt"],
  "properties": {
    "lotId": { "$ref": "../common/_values.schema.json#/$defs/ulid" },
    "symbol": { "$ref": "../common/_values.schema.json#/$defs/symbol" },
    "quantity": { "$ref": "../common/_values.schema.json#/$defs/decimal" },
    "unitCost": { "$ref": "../common/_values.schema.json#/$defs/money" },
    "origin": { "type": "string", "enum": ["MANUAL", "AI_RECOMMENDED", "AUTO_BUY"] },
    "fxAtBuy": { "oneOf": [{ "$ref": "../common/_values.schema.json#/$defs/exchangeRate" }, { "type": "null" }] },
    "openedAt": { "$ref": "../common/_values.schema.json#/$defs/instant" }
  }
}
