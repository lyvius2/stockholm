{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockholm.banghak/protocol/api/api-chart-view.schema.json",
  "title": "ApiChartView",
  "description": "GET/PUT /session/chart-view. 자세한 차트 토글과 모드별 마지막 기간 탭. 사용자 설정이라 종목·재시작·디바이스가 바뀌어도 유지됨.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "isDetailed",
    "simpleRange",
    "detailedResolution"
  ],
  "properties": {
    "isDetailed": {
      "type": "boolean"
    },
    "simpleRange": {
      "description": "간단 차트의 기간 탭: 장중 · 1일 · 1주 · 3달 · 1년 · 5년 · 전체",
      "type": "string",
      "enum": [
        "INTRADAY",
        "DAY_1",
        "WEEK_1",
        "MONTH_3",
        "YEAR_1",
        "YEAR_5",
        "ALL"
      ]
    },
    "detailedResolution": {
      "description": "자세한 차트의 봉 단위(분 1·3·5·10·30·60 · 일 · 주 · 월 · 년)",
      "type": "string",
      "enum": [
        "MINUTE_1",
        "MINUTE_3",
        "MINUTE_5",
        "MINUTE_10",
        "MINUTE_30",
        "MINUTE_60",
        "DAY",
        "WEEK",
        "MONTH",
        "YEAR"
      ]
    }
  }
}
