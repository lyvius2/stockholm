{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockholm.banghak/protocol/api/api-credential-kind.schema.json",
  "title": "ApiCredentialKind",
  "description": "GET /setup/catalog 의 항목. 키 종류의 메타(값·상태 없음).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "group", "scope", "required", "fields", "isSecret", "isLlm"],
  "properties": {
    "kind": { "type": "string", "enum": ["OPENAI","ANTHROPIC","DEEPSEEK","OLLAMA","DART","KRX","MASSIVE","NAVER","ODCLOUD","SEC_CONTACT_EMAIL","FRED","SLACK","KFTC_APP","CACHE_SERVER","TOSS"] },
    "group": { "type": "string", "enum": ["LLM", "DISCLOSURE", "MARKET_DATA", "NEWS", "PUBLIC_DATA", "NOTIFICATION", "KFTC", "CACHE", "BROKER"] },
    "scope": { "type": "string", "enum": ["SHARED", "USER"] },
    "required": { "type": "boolean" },
    "fields": { "type": "array", "items": { "type": "string" } },
    "isSecret": { "type": "boolean" },
    "isLlm": { "type": "boolean" }
  }
}
