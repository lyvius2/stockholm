{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockholm.banghak/protocol/api/api-credential-check.schema.json",
  "title": "ApiCredentialCheck",
  "description": "키 검증 결과. 값은 없음.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "detail"],
  "properties": {
    "result": { "type": "string", "enum": ["OK", "REJECTED", "UNREACHABLE"] },
    "reason": { "type": ["string", "null"] },
    "detail": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
